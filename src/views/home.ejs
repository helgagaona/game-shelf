<%- include('partials/header') %>
<main> 
  <section class="home-hero" aria-labelledby="home-title">
    <div>
      <h5>Your neighborhood game library</h5>
      <h1>Good games are better together.</h1>
      <p>
        Find your next game-night favorite, bring everyone to the table, and
        make room for a little friendly competition.
      </p>
      <div class="actions">
        <a class="primary-btn" href="/games">Explore the catalog</a>
        <a class="secondary-btn" href="#how-it-works">How borrowing works</a>
      </div>
    </div>
    <aside class="hero-callout" aria-label="About the Game Shelf">
      <h5>The Game Shelf</h5>
      <h4>A little less scrolling. A lot more playing.</h4>
      <p>Discover something new to enjoy with friends, family, or your next game group.</p>
    </aside>
  </section>

  <section aria-labelledby="moods-title">
    <h5>Find your kind of fun</h5>
    <h2>What sounds good tonight?</h2>
    <div class="home-moods">
      <article class="card">
        <h5>01</h5>
        <h3>A clever challenge</h3>
        <p>Make a plan, outsmart the board, and see where your next move takes you.</p>
      </article>
      <article class="card">
        <h5>02</h5>
        <h3>Teamwork around the table</h3>
        <p>Share ideas, combine your strengths, and see if you can win together.</p>
      </article>
      <article class="card">
        <h5>03</h5>
        <h3>Easygoing laughs</h3>
        <p>Keep it light with a game that gets everyone talking and joining in.</p>
      </article>
    </div>
  </section>

  <section class="home-how" aria-labelledby="how-title">
    <div>
      <h5>A game night, made simple</h5>
      <h2>From shelf to table</h2>
    </div>
    <ol class="home-steps">
      <li><span>01</span><p><strong>Browse</strong> the catalog and find a game that fits your group.</p></li>
      <li><span>02</span><p><strong>Choose</strong> something familiar or try a game you have never played.</p></li>
      <li><span>03</span><p><strong>Play</strong> together, then follow the library's borrowing instructions for return.</p></li>
    </ol>
  </section>

  <section class="home-community" aria-labelledby="community-title">
    <div>
      <h5>Good games grow a community</h5>
      <h2>Have a favorite to recommend?</h2>
      <p>Explore the shared collection and help make the next game night memorable.</p>
    </div>
    <a class="secondary-btn" href="/games">See the collection</a>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
