<%
  // Optional locals a controller can pass in: errors, formData, categories
  const errors = locals.errors || {};
  const formData = locals.formData || {};
  const categories = locals.categories || ['Strategy', 'Cooperative', 'Family', 'Party', 'Mystery', 'Word Game'];
  const hasErrors = Object.keys(errors).length > 0;
%>
<%- include('../partials/header') %>
<main>
  <section class="form-card" aria-labelledby="register-title">
    <h5>Join the library</h5>
    <h2 id="register-title">Create your Game Shelf account</h2>
    <p>Sign up to borrow games, save favorites, and join the next game night.</p>

    <% if (hasErrors) { %>
      <div class="form-alert" role="alert">
        <p>Please fix the highlighted fields and try again.</p>
      </div>
    <% } %>

    <form class="form" action="/register" method="post" novalidate>
      <div class="form-row">
        <div class="form-field">
          <label for="firstName">First name</label>
          <input type="text" id="firstName" name="firstName" autocomplete="given-name"
                 value="<%= formData.firstName || '' %>" required
                 <% if (errors.firstName) { %>aria-invalid="true" aria-describedby="firstName-error"<% } %>>
          <% if (errors.firstName) { %><p class="form-error" id="firstName-error"><%= errors.firstName %></p><% } %>
        </div>

        <div class="form-field">
          <label for="lastName">Last name</label>
          <input type="text" id="lastName" name="lastName" autocomplete="family-name"
                 value="<%= formData.lastName || '' %>" required
                 <% if (errors.lastName) { %>aria-invalid="true" aria-describedby="lastName-error"<% } %>>
          <% if (errors.lastName) { %><p class="form-error" id="lastName-error"><%= errors.lastName %></p><% } %>
        </div>
      </div>

      <div class="form-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email"
               value="<%= formData.email || '' %>" required
               <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
        <% if (errors.email) { %><p class="form-error" id="email-error"><%= errors.email %></p><% } %>
      </div>

      <div class="form-row">
        <div class="form-field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" autocomplete="new-password"
                 minlength="8" required
                 aria-describedby="password-hint<% if (errors.password) { %> password-error<% } %>"
                 <% if (errors.password) { %>aria-invalid="true"<% } %>>
          <p class="form-hint" id="password-hint">At least 8 characters.</p>
          <% if (errors.password) { %><p class="form-error" id="password-error"><%= errors.password %></p><% } %>
        </div>

        <div class="form-field">
          <label for="confirmPassword">Confirm password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password"
                 minlength="8" required
                 <% if (errors.confirmPassword) { %>aria-invalid="true" aria-describedby="confirmPassword-error"<% } %>>
          <% if (errors.confirmPassword) { %><p class="form-error" id="confirmPassword-error"><%= errors.confirmPassword %></p><% } %>
        </div>
      </div>

      <div class="form-field">
        <label for="favoriteCategory">Favorite kind of game</label>
        <select id="favoriteCategory" name="favoriteCategory">
          <option value="">No preference</option>
          <% categories.forEach(category => { %>
            <option value="<%= category %>" <%= formData.favoriteCategory === category ? 'selected' : '' %>><%= category %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-field">
        <div class="form-check">
          <input type="checkbox" id="terms" name="terms" value="yes" required
                 <%= formData.terms ? 'checked' : '' %>
                 <% if (errors.terms) { %>aria-invalid="true" aria-describedby="terms-error"<% } %>>
          <label for="terms">I agree to return games on time and follow the library's <a href="/privacy">privacy policy</a>.</label>
        </div>
        <% if (errors.terms) { %><p class="form-error" id="terms-error"><%= errors.terms %></p><% } %>
      </div>

      <div class="actions">
        <button type="submit" class="primary-btn">Create account</button>
        <a class="secondary-btn" href="/games">Browse the catalog first</a>
      </div>
    </form>

    <p class="form-footer">Already a member? <a class="link" href="/login">Log in</a></p>
  </section>
</main>
<%- include('../partials/footer') %>
</body>
</html>
