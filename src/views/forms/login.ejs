<%
  // Optional locals a controller can pass in: errors, formData
  const errors = locals.errors || {};
  const formData = locals.formData || {};
  const hasErrors = Object.keys(errors).length > 0;
%>
<%- include('../partials/header') %>
<main>
  <section class="form-card" aria-labelledby="login-title">
    <h5>Welcome back</h5>
    <h2 id="login-title">Log in to Game Shelf</h2>
    <p>Pick up where you left off and find your next game night favorite.</p>

    <% if (hasErrors) { %>
      <div class="form-alert" role="alert">
        <p><%= errors.form || 'Please fix the highlighted fields and try again.' %></p>
      </div>
    <% } %>

    <form class="form" action="/login" method="post" novalidate>
      <div class="form-field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" autocomplete="email"
               value="<%= formData.email || '' %>" required
               <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
        <% if (errors.email) { %><p class="form-error" id="email-error"><%= errors.email %></p><% } %>
      </div>

      <div class="form-field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" required
               <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>>
        <% if (errors.password) { %><p class="form-error" id="password-error"><%= errors.password %></p><% } %>
      </div>

      <div class="form-check">
        <input type="checkbox" id="remember" name="remember" value="yes" <%= formData.remember ? 'checked' : '' %>>
        <label for="remember">Keep me logged in on this device</label>
      </div>

      <div class="actions">
        <button type="submit" class="primary-btn">Log in</button>
        <a class="secondary-btn" href="/games">Browse the catalog</a>
      </div>
    </form>

    <p class="form-footer">New here? <a class="link" href="/registration">Create an account</a></p>
  </section>
</main>
<%- include('../partials/footer') %>
</body>
</html>
