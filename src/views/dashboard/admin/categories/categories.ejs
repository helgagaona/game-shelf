<%- include('../../../partials/header') %>
<main>
  <section aria-labelledby="categories-title">

    <div class="list-header">
      <div>
        <h5>Admin</h5>
        <h2 id="categories-title">Categories</h2>
        <p>Group games in the catalog. Hide a category instead of deleting it.</p>
      </div>
      <div class="actions">
        <a class="primary-btn" href="/admin/categories/add-category">Add category</a>
      </div>
    </div>

    <div class="table-wrap">
      <table class="data-table" aria-label="Categories">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Description</th>
            <th scope="col" class="col-number">Games</th>
            <th scope="col">Status</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% Object.values(categories).forEach(category => { %>
          <tr>
            <td><%= category.name %></td>
            <td><%= category.description %></td>
            <td class="col-number"><%= category.gameCount %></td>
            <td><span class="status-badge <%= category.isActive ? '' : 'status-badge--inactive' %>"><%= category.isActive ? 'Active' : 'Inactive' %></span></td>
            <td>
              <div class="row-actions">
                <a class="link" href="/admin/categories/<%= category.id %>/edit">Edit</a>
                <form action="/admin/categories/<%= category.id %>/<%= category.isActive ? 'deactivate' : 'activate' %>" method="post">
                  <button type="submit" class="link-btn"><%= category.isActive ? 'Deactivate' : 'Activate' %></button>
                </form>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

  </section>
</main>
<%- include('../../../partials/footer') %>
</body>
</html>
