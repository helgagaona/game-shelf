<%- include('../../../partials/header') %>
<main>
  <section class="form-card" aria-labelledby="category-title">
    <h5>Add a new category</h5>
    <p>Categories group games in the catalog, such as Strategy or Party.</p>

    <form class="form" action="/admin/categories" method="post" novalidate>

      <div class="form-field">
        <label for="name">Name</label>

        <input type="text" id="name" name="name" maxlength="50" required aria-describedby="name-hint">
      </div>

      <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4"></textarea>
        <p class="form-hint">Optional. A short note about what belongs in this category.</p>
      </div>

      <div class="form-field">
        <div class="form-check">
          <input type="checkbox" id="is_active" name="is_active" value="true">
          <label for="is_active">Active (shown in the catalog)</label>
        </div>
        <p class="form-hint">Uncheck to hide the category instead of deleting it.</p>
      </div>

      <div class="actions">
        <button type="submit" class="primary-btn">Save category</button>
        <a class="secondary-btn" href="/admin/categories">Cancel</a>
      </div>
    </form>
  </section>
</main>
<%- include('../../../partials/footer') %>
</body>
</html>
